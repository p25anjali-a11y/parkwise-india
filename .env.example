# Copy to .env.local. Never commit real values. Every key is optional until its slice is built;
# missing keys make the matching provider fall back to a labelled MOCK.

# --- Supabase (create the project in ap-south-1, Mumbai) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for migrations (use the pooler URL at runtime)
DATABASE_URL=

# --- Routing (per-city provider chosen in config) ---
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPPLS_REST_KEY=
OLA_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Traffic signals (implement one real adapter: HERE or TomTom) ---
HERE_API_KEY=
TOMTOM_API_KEY=

# --- Payments (Razorpay TEST mode only) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Security ---
# Signs QR check-in tokens
CHECKIN_TOKEN_SECRET=
# Secret used to hash vehicle numbers (HMAC). Rotating it invalidates saved vehicle matches.
VEHICLE_HASH_SECRET=
# Protects /api/cron/* routes; Vercel sends it as a Bearer token
CRON_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- Forecast service (optional Python service; baseline runs in-process without it) ---
FORECAST_SERVICE_URL=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts feed webhook secrets at rest.
FEED_ENCRYPTION_KEY=
